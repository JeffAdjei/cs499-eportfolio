    html.H1("Grazioso Salvare Dashboard", style={"textAlign": "center"}),

    html.Label("Animal Type"),
    dcc.Dropdown(
        id="animal-type-dropdown",
        options=create_dropdown_options(df["animal_type"]) if not df.empty else [],
        placeholder="Select Animal Type"
    ),

    html.Label("Breed"),
    dcc.Dropdown(
        id="breed-dropdown",
        placeholder="Select Breed"
    ),

    html.Label("Outcome Type"),
    dcc.Dropdown(
        id="outcome-type-dropdown",
