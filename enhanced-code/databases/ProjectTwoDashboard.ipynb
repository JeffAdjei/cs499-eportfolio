    html.Label("Rescue Type"),
    dcc.Dropdown(
        id="rescue-type-dropdown",
        options=[
            {"label": "Water Rescue", "value": "Water Rescue"},
            {"label": "Mountain or Wilderness Rescue", "value": "Mountain or Wilderness Rescue"},
