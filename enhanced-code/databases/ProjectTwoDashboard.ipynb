# === Callbacks ===

@app.callback(
    Output("breed-dropdown", "options"),
    Input("animal-type-dropdown", "value")
)
def update_breed_options(selected_type):
    if selected_type:
        breed_data = shelter.read(
            query={"animal_type": selected_type},
            projection={"_id": 0, "breed": 1},
            sort=[("breed", 1)]
        )
        breed_df = pd.DataFrame(breed_data)

        if breed_df.empty or "breed" not in breed_df.columns:
            return []

        breeds = sorted(breed_df["breed"].dropna().unique())
        return [{"label": breed, "value": breed} for breed in breeds]

    return []

@app.callback(
    Output("breed-dropdown", "value"),
    Input("animal-type-dropdown", "value")
)
def clear_breed_on_type_change(animal_type):
    return None

@app.callback(
    Output("animal-table", "data"),
    [
        Input("animal-type-dropdown", "value"),
        Input("breed-dropdown", "value"),
        Input("outcome-type-dropdown", "value"),
        Input("sex-dropdown", "value"),
        Input("rescue-type-dropdown", "value")
    ]
)
def update_table(animal, breed, outcome, sex, rescue):
    data = get_filtered_data(animal, breed, outcome, sex, rescue)
    return data.to_dict("records")

@app.callback(
    Output("outcome-chart", "figure"),
    [
        Input("animal-type-dropdown", "value"),
        Input("breed-dropdown", "value"),
        Input("outcome-type-dropdown", "value"),
        Input("sex-dropdown", "value"),
        Input("rescue-type-dropdown", "value")
    ]
)
def update_pie_chart(animal, breed, outcome, sex, rescue):
    data = get_filtered_data(animal, breed, outcome, sex, rescue)

    if data.empty or "outcome_type" not in data.columns:
        return px.pie(title="No data available")

    counts = data["outcome_type"].value_counts()
    return px.pie(
        names=counts.index,
        values=counts.values,
        title="Outcome Type Distribution"
    )

@app.callback(
    Output("location-map", "figure"),
    [
        Input("animal-type-dropdown", "value"),
        Input("breed-dropdown", "value"),
        Input("outcome-type-dropdown", "value"),
        Input("sex-dropdown", "value"),
        Input("rescue-type-dropdown", "value")
    ]
)
def update_map(animal, breed, outcome, sex, rescue):
    data = get_filtered_data(animal, breed, outcome, sex, rescue)

    required_columns = {"location_lat", "location_long", "name"}
    if data.empty or not required_columns.issubset(set(data.columns)):
        return px.scatter_mapbox(title="No location data available")

    fig = px.scatter_mapbox(
        data,
        lat="location_lat",
        lon="location_long",
        hover_name="name",
        hover_data={
            "breed": True,
            "age_upon_outcome_in_weeks": True
        },
        zoom=10,
        height=400
    )

    fig.update_layout(
        mapbox_style="open-street-map",
        margin={"r": 0, "t": 30, "l": 0, "b": 0},
        title="Animal Locations"
    )
    return fig

@app.callback(
    Output("bar-chart", "figure"),
    [
        Input("animal-type-dropdown", "value"),
        Input("breed-dropdown", "value"),
        Input("outcome-type-dropdown", "value"),
        Input("sex-dropdown", "value"),
        Input("rescue-type-dropdown", "value")
    ]
)
def update_bar_chart(animal, breed, outcome, sex, rescue):
    data = get_filtered_data(animal, breed, outcome, sex, rescue)

    if data.empty or "breed" not in data.columns:
        return px.bar(title="No data available")

    breed_counts = data["breed"].value_counts().nlargest(10)

    fig = px.bar(
        x=breed_counts.index,
        y=breed_counts.values,
        labels={"x": "Breed", "y": "Count"},
        title="Top 10 Breeds by Count"
    )
    fig.update_layout(xaxis_tickangle=-45)
    return fig

# === Run the App ===
app.run()