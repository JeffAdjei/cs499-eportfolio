# === Required Imports ===
import pandas as pd
from dash import Dash, dcc, html, dash_table, Input, Output
import plotly.express as px
from AnimalShelter import AnimalShelter

# === MongoDB Connection ===
username = "aacuser"
password = "SNHU1234"
shelter = AnimalShelter(username, password)

# Initial dataset for app startup
initial_records = shelter.read_for_dashboard({})
df = pd.DataFrame(initial_records)
print(f"Connected to MongoDB | Retrieved {len(df)} records")

# === Rescue Filter Helper ===
def build_rescue_query(rescue_type):
    """
    Build rescue-specific MongoDB query filters.
    """
    if not rescue_type:
        return {}

    if rescue_type == "Water Rescue":
        return {
            "breed": {
                "$in": [
                    "Labrador Retriever Mix",
                    "Chesapeake Bay Retriever",
                    "Newfoundland"
                ]
            },
            "age_upon_outcome_in_weeks": {"$lte": 104}
        }

    if rescue_type == "Mountain or Wilderness Rescue":
        return {
            "breed": {
                "$in": [
                    "German Shepherd",
                    "German Shepherd Mix",
                    "Alaskan Malamute",
                    "Old English Sheepdog",
                    "Siberian Husky",
                    "Rottweiler"
                ]
            },
            "age_upon_outcome_in_weeks": {"$lte": 156}
        }

    if rescue_type == "Disaster or Individual Tracking":
        return {
            "breed": {
                "$in": [
                    "Doberman Pinscher",
                    "German Shepherd",
                    "Golden Retriever",
                    "Bloodhound",
                    "Rottweiler"
                ]
            },
            "age_upon_outcome_in_weeks": {"$lte": 300}
        }

    return {}

# === Query Builder ===
def build_query(animal_type=None, breed=None, outcome_type=None, sex=None, rescue=None):
    """
    Build a MongoDB query from dashboard filter selections.
    """
    query = {}

    if animal_type:
        query["animal_type"] = animal_type

    if breed:
        query["breed"] = breed

    if outcome_type:
        query["outcome_type"] = outcome_type

    if sex:
        query["sex_upon_outcome"] = sex

    rescue_query = build_rescue_query(rescue)
    query.update(rescue_query)

    return query

# === Data Retrieval Helper ===
def get_filtered_data(animal_type=None, breed=None, outcome_type=None, sex=None, rescue=None):
    """
    Retrieve filtered data directly from MongoDB instead of filtering
    the full dataset in pandas.
    """
    query = build_query(animal_type, breed, outcome_type, sex, rescue)
    records = shelter.read_for_dashboard(query)
    filtered_df = pd.DataFrame(records)

    if filtered_df.empty:
        return pd.DataFrame(columns=[
            "name",
            "animal_type",
            "breed",
            "color",
            "date_of_birth",
            "outcome_type",
            "sex_upon_outcome",
            "age_upon_outcome_in_weeks",
            "location_lat",
            "location_long"
        ])

    return filtered_df

# === Dropdown Option Helper ===
def create_dropdown_options(series):
    """
    Convert a pandas Series into sorted dropdown options.
    """
    values = sorted([value for value in series.dropna().unique()])
    return [{"label": value, "value": value} for value in values]

# === App Initialization ===
app = Dash(__name__)

# === App Layout ===
