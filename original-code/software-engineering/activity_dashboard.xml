<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DashboardActivity">

    <!-- Date -->
    <EditText
        android:id="@+id/inputDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Date (e.g., 2025-08-17)"
        android:inputType="date"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Weight -->
    <EditText
        android:id="@+id/inputWeight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Weight (lbs)"
        android:inputType="numberDecimal"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/inputDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Goal weight -->
    <EditText
        android:id="@+id/inputGoal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Set Goal Weight (lbs)"
        android:inputType="numberDecimal"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/inputWeight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Set Goal button -->
    <Button
        android:id="@+id/buttonSetGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Goal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/inputGoal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/addDataButton" />

    <!-- Add Entry button -->
    <Button
        android:id="@+id/addDataButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Entry"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/inputGoal"
        app:layout_constraintStart_toEndOf="@id/buttonSetGoal"
        app:layout_constraintEnd_toStartOf="@id/buttonOpenSmsPermission" />

    <!-- Open SMS Permission screen -->
    <Button
        android:id="@+id/buttonOpenSmsPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS Permission"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/inputGoal"
        app:layout_constraintStart_toEndOf="@id/addDataButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Goal label -->
    <TextView
        android:id="@+id/textGoalDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Goal: not set"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/addDataButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll area for table -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/textGoalDisplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableLayout
            android:id="@+id/dataGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:paddingBottom="24dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>